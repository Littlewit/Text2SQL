# Text2SQL 后端环境变量样例（DEP-03、KEY-04）
# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，严禁提交真实密钥

# --- 应用 ---
DEBUG=true

# --- 元数据库（PostgreSQL + pgvector；docker-compose.dev.yml 提供的默认连接）---
METADATA_DB_URL=postgresql+psycopg://t2s:t2s@localhost:5432/text2sql_meta
DB_ECHO=false
DB_POOL_SIZE=10

# --- Redis（Celery broker + 限流计数器）---
REDIS_URL=redis://localhost:6379/0

# --- LLM（DeepSeek；KEY-01：仅环境变量注入）---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=30

# --- Embedding（维度须与模型一致，DR-04）---
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# --- 时区（DEP-09）---
TIMEZONE=Asia/Shanghai
